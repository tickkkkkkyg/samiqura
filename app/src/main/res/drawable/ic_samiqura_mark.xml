<?xml version="1.0" encoding="utf-8"?>
<!--
  Samiqura brand mark: a shield with a stylised "S" aperture.

  Drawn as a vector so it stays crisp at every launcher size, themes correctly
  on Android 13+ themed icons via <monochrome>, and needs no density buckets.
  All artwork sits inside the 66dp adaptive-icon safe zone (viewport 108dp,
  centre 54,54) so no launcher mask can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shield body -->
    <path
        android:fillColor="#7C3AED"
        android:pathData="M54,26 L76,34 L76,52 C76,66 66,76 54,81 C42,76 32,66 32,52 L32,34 Z" />

    <!-- Inner highlight edge, gives depth without a gradient -->
    <path
        android:fillColor="#A78BFA"
        android:pathData="M54,30 L72,37 L72,52 C72,64 63,73 54,77.5 C45,73 36,64 36,52 L36,37 Z" />

    <!-- Stylised S aperture -->
    <path
        android:fillColor="#FFFFFF"
